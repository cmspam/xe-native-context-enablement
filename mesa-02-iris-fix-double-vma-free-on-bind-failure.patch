Subject: [PATCH] iris: don't free the VMA twice when binding a new BO fails

When gem_vm_bind() fails in iris_bo_alloc(), iris_bo_gem_create_from_name(),
iris_bo_import_dmabuf() or intel_aux_map_buffer_alloc(), the error path calls
vma_free() and then bo_free().  bo_free() ends up in bo_close(), which still
sees a non-zero bo->address, unbinds it (unmapping a range that was never
mapped succeeds) and calls vma_free() on the same range a second time.

util_vma_heap_free() does not catch this in release builds: the range is
added as a new hole overlapping the hole it was already merged into, so later
allocations can hand the same GPU address to two BOs.  On Xe the second
VM_BIND silently replaces the first mapping and textures end up sampling
other buffers' memory.

This is easy to hit with virtio-gpu native context: importing a guest-memory
dma-buf (e.g. the udmabuf KWin creates for every wl_shm client buffer) always
fails at VM_BIND time on the host, and the resulting double frees corrupt the
whole desktop.

Let bo_close() release the VMA, as it does for every other BO.  Keeping its
unbind also moves the Xe bind timeline past the point used by the failed bind.

---
diff --git a/src/gallium/drivers/iris/iris_bufmgr.c b/src/gallium/drivers/iris/iris_bufmgr.c
index 7e738bb..76add27 100644
--- a/src/gallium/drivers/iris/iris_bufmgr.c
+++ b/src/gallium/drivers/iris/iris_bufmgr.c
@@ -1328,7 +1328,7 @@ iris_bo_alloc(struct iris_bufmgr *bufmgr,
          goto err_free;
 
       if (!bufmgr->kmd_backend->gem_vm_bind(bo, flags))
-         goto err_vm_alloc;
+         goto err_free;
    }
 
    bo->name = name;
@@ -1356,10 +1356,6 @@ iris_bo_alloc(struct iris_bufmgr *bufmgr,
 
    return bo;
 
-err_vm_alloc:
-   simple_mtx_lock(&bufmgr->lock);
-   vma_free(bufmgr, bo->address, bo->size);
-   simple_mtx_unlock(&bufmgr->lock);
 err_free:
    simple_mtx_lock(&bufmgr->lock);
    bo_free(bo);
@@ -1532,10 +1528,10 @@ iris_bo_gem_create_from_name(struct iris_bufmgr *bufmgr,
       goto err_free;
 
    if (!iris_bo_set_prime_fd(bo))
-      goto err_vm_alloc;
+      goto err_free;
 
    if (!bufmgr->kmd_backend->gem_vm_bind(bo, flags))
-      goto err_vm_alloc;
+      goto err_free;
 
    _mesa_hash_table_insert(bufmgr->handle_table, &bo->gem_handle, bo);
    _mesa_hash_table_insert(bufmgr->name_table, &bo->real.global_name, bo);
@@ -1546,10 +1542,6 @@ out:
    simple_mtx_unlock(&bufmgr->lock);
    return bo;
 
-err_vm_alloc:
-   vma_free(bufmgr, bo->address, bo->size);
-   /* clear bo->address to prevent double free in bo_close() */
-   bo->address = 0;
 err_free:
    bo_free(bo);
    simple_mtx_unlock(&bufmgr->lock);
@@ -2102,7 +2094,7 @@ iris_bo_import_dmabuf(struct iris_bufmgr *bufmgr, int prime_fd,
       goto err_free;
 
    if (!bufmgr->kmd_backend->gem_vm_bind(bo, flags))
-      goto err_vm_alloc;
+      goto err_free;
 
    _mesa_hash_table_insert(bufmgr->handle_table, &bo->gem_handle, bo);
 
@@ -2118,8 +2110,6 @@ out:
 
    return bo;
 
-err_vm_alloc:
-   vma_free(bufmgr, bo->address, bo->size);
 err_free:
    bo_free(bo);
    simple_mtx_unlock(&bufmgr->lock);
@@ -2363,7 +2353,7 @@ intel_aux_map_buffer_alloc(void *driver_ctx, uint32_t size)
       goto err_free;
 
    if (!bufmgr->kmd_backend->gem_vm_bind(bo, 0))
-      goto err_vm_alloc;
+      goto err_free;
 
    simple_mtx_unlock(&bufmgr->lock);
 
@@ -2379,8 +2369,6 @@ intel_aux_map_buffer_alloc(void *driver_ctx, uint32_t size)
    buf->map = iris_bo_map(NULL, bo, MAP_WRITE | MAP_RAW);
    return buf;
 
-err_vm_alloc:
-   vma_free(bufmgr, bo->address, bo->size);
 err_free:
    free(buf);
    bo_free(bo);
